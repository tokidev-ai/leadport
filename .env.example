# Copy to .env.local and fill in real values. Never commit .env.local or any
# file containing real secrets — see CLAUDE.md §3.

# Firebase client config (src/lib/firebase/client.ts). These identify the
# Firebase project to the browser SDK — Firebase's own security model treats
# them as non-secret (access is enforced by security rules / App Check, not
# by hiding this config) — but real values still belong only in .env.local,
# never in this example file.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# "true" to connect both SDKs to the local emulator suite (npm run
# emulators) instead of the real project. Set this for local dev.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=

# Admin SDK (src/lib/firebase/admin.ts), server-only. NOT needed for local
# dev against emulators — only required in deployed environments. This is a
# REAL secret: the full service account JSON as one line. Generate it from
# https://console.firebase.google.com/project/<project-id>/settings/serviceaccounts/adminsdk
# and set it directly in the hosting platform's secret store (Vercel), never
# here.
FIREBASE_SERVICE_ACCOUNT_KEY=
