rules_version = '2';

// PLAN.md §6: writes scoped to users/{uid}/*, size-capped, image-only.
//
// Read policy isn't spelled out in §6 (only the write constraint is) — set
// to public here because these are profile/property photos rendered on
// public agent pages; restricting reads would break the product.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size <= 10 * 1024 * 1024
                   && request.resource.contentType.matches("image/.*");
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
